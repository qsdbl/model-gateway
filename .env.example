# ============================================================
# Model Gateway 环境变量示例
# 复制为 .env 后按实际情况填写；所有项都有安全默认值，可按需只配需要的。
# 警告：.env 含密钥，权限设为 600，绝不提交 git。
# ============================================================

# ---------- 监听 ----------
GATEWAY_HOST=127.0.0.1            # 默认只回环；公网部署请经 HTTPS 反代，勿裸绑 0.0.0.0
GATEWAY_PORT=8080

# ---------- 数据 ----------
GATEWAY_DATA_DIR=data             # 相对路径按项目根解析；SQLite 库自动建表
GATEWAY_DB_NAME=gateway.db

# ---------- 鉴权（重要）----------
GATEWAY_API_KEY=                  # 客户端调 /v1/* 的 Bearer key；留空=本地开发不校验
GATEWAY_ADMIN_TOKEN=              # 后台登录口令；留空=后台整站 503（fail-safe）

# ---------- 上游 ----------
GATEWAY_UPSTREAM=mock             # mock=看界面（默认）；workbuddy=真实账号
GATEWAY_UPSTREAM_TIMEOUT=60

# 两个对外模型名（客户端 model 字段填这两个）
GATEWAY_LOW_MODEL=low
GATEWAY_HIGH_MODEL=high

# ---------- 上游 CLI 路径 ----------
# codebuddy（WorkBuddy 扫码/签到用）：留空则从 PATH 查找
GATEWAY_CLI_BIN=
# qoderclicn（Qoder 上游）：留空则从 PATH 查找（pip 装 qodercn-agent-sdk 自带）
GATEWAY_QODER_CLI=
# 主号显示名映射（JSON 对象 nickname->显示名），无需改名可留空
GATEWAY_DISPLAY_ALIAS=

# ---------- 邮件（也可在后台「安全」页配置，存 SQLite；这里作兜底）----------
GATEWAY_ADMIN_EMAIL=              # 找回邮件收件人
GATEWAY_SMTP_HOST=
GATEWAY_SMTP_PORT=465
GATEWAY_SMTP_USER=
GATEWAY_SMTP_PASSWORD=            # 邮箱授权码（不是登录密码）
GATEWAY_SMTP_FROM=
GATEWAY_SMTP_SSL=1                # 465=1；587=0
GATEWAY_ADMIN_MAGIC_TTL=900
GATEWAY_ADMIN_MAGIC_LIMIT=3
GATEWAY_ADMIN_MAGIC_WINDOW=3600

# ---------- 后台会话 ----------
GATEWAY_ADMIN_SESSION_TTL=2592000  # 30 天不活动失效
GATEWAY_ADMIN_SESSION_MAX=15552000 # 180 天绝对上限
GATEWAY_ADMIN_FAIL_LIMIT=10
GATEWAY_ADMIN_FAIL_WINDOW=86400
GATEWAY_ADMIN_BLOCK_TTL=86400

# ---------- 对外地址（后台「接入」页生成配置块用，不参与路由）----------
GATEWAY_PUBLIC_BASE=              # 例：https://your-domain.example/gw
GATEWAY_PUBLIC_HTTPS=             # 固定 HTTPS 入口，留空则自动探测
GATEWAY_PUBLIC_PREFIX=/gw

# ---------- 公网隧道（可选，cloudflared quick tunnel metrics）----------
GATEWAY_TUNNEL_METRICS=http://127.0.0.1:20241

# ---------- 后台任务 ----------
GATEWAY_BACKGROUND=1              # 0=关闭后台定时任务（签到/探针/续期）

# ---------- 调度 ----------
GATEWAY_CONTEXT_WINDOW=           # 留空=不限制
